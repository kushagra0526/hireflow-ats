# MongoDB Atlas connection string. Leave unset in development to use a throwaway in-memory MongoDB.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hireflow?retryWrites=true&w=majority
# Long random string used to sign login tokens (required in production)
JWT_SECRET=change-me
# The single admin account
ADMIN_EMAIL=admin@hireflow.dev
ADMIN_PASSWORD=admin123
